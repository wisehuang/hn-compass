# Required for the Web service, migrations, and daily ingestion.
# On Railway, reference the private PostgreSQL service's DATABASE_URL variable.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hn_compass

# Required for daily ingestion and protected internal operations.
RSS_URL=https://www.daemonology.net/hn-daily/index.rss
OPENAI_API_KEY=replace-with-an-openai-api-key
OPENAI_MODEL=gpt-5-mini

# Required only by protected /api/internal/* POST routes.
# Generate a unique long random value; do not reuse it as an OpenAI or database secret.
INTERNAL_JOB_SECRET=replace-with-a-long-random-secret

# Optional: used by database-backed integration tests.
TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/hn_compass_test
